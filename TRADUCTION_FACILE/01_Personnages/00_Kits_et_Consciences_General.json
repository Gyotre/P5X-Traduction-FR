{
  "r:\"Deal Ice damage to all foes equal to <color\\=#FFFC40>(.+?)%</color> of Yusuke's Defense\\. Inflict <link\\=(.+?)><u>Freeze</u></link> on main target for (\\d+) turns\\.\\n<b><size\\=28><color\\=#850101>(.+?)</color></size></b>\"": "",
