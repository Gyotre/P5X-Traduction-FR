  "r:\"^Ice\\s+dmg\\s+to\\s+(\\d+)\\s+foe\\s+\\((\\d+\\.?\\d*)%\\s+Atk\\),\\s+(\\d+\\.?\\d*)%\\s+chance\\s+to\\s+inflict\\s+Icebound\\.\\s+When\\s+Winter's\\s+Edge\\s+is\\s+active,\\s+increase\\s+chance\\s+to\\s+inflict\\s+Icebound\\s+(\\d+\\.?\\d*)%\\.\\s+If\\s+Winter's\\s+Edge\\s+is\\s+not\\s+active,\\s+increase\\s+Highlight\\s+dmg\\s+(\\d+)%\\.$\"": "",
