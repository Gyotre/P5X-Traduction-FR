  "G<color=#000000>r</color>eenleaf": "",
  "r:\"^Deal\\\\s+Psy\\\\s+damage\\\\s+to\\\\s+foes\\\\s+equal\\\\s+to\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+of\\\\s+Attack\\\\s+\\\\((\\d+)\\\\s+hits\\\\)\\\\.\\\\s*From\\\\s+the\\\\s+second\\\\s+hit,\\\\s+prioritize\\\\s+new\\\\s+targets\\\\s+and\\\\s+inflict\\\\s+(\\d+)\\\\s+<link\\=\"s\\\\|(\\d+)\"><u>Sparks</u></link>\\\\s+stack\\\\s+per\\\\s+hit\\\\.\\\\s*Deal\\\\s+(\\d+)%\\\\s+damage\\\\s+for\\\\s+hits\\\\s+on\\\\s+the\\\\s+same\\\\s+target\\\\.\\\\nPassive:\\\\s+Increase\\\\s+<link\\=\"s\\\\|(\\d+)\"><u>Summer\\\\s+Reminiscence</u></link>\\\\s+skill\\\\s+damage\\\\s+multiplier\\\\s+and\\\\s+healing\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\.\\\\n<b><size\\=28><color\\=#850101>A\\\\s+freezing\\\\s+cold\\\\s+drink\\\\s+that\\\\s+jolts\\\\s+the\\\\s+drinker\\\\s+wide\\\\s+awake,\\\\s+dealing\\\\s+Psychokinesis\\\\s+damage\\\\s+to\\\\s+foes\\\\.</color></size></b>$\"": "",
  "r:\"^Restore\\\\s+(\\d+)\\\\s+ally's\\\\s+HP\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+of\\\\s+Seaside\\\\s+Tomoko's\\\\s+Attack\\\\s+\\\\+\\\\s+<color\\=#FFFC40>(\\d+)</color>\\\\.\\\\s*For\\\\s+(\\d+)\\\\s+turns,\\\\s+increase\\\\s+the\\\\s+target's\\\\s+Attack\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>,\\\\s+ailment\\\\s+accuracy\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>,\\\\s+and\\\\s+damage\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+)%</color>\\\\.\\\\s*Also,\\\\s+increase\\\\s+Attack\\\\s+\\\\(up\\\\s+to\\\\s+(\\d+\\.?\\d*)%\\\\)\\\\s+by\\\\s+(\\d+)%\\\\s+of\\\\s+the\\\\s+target's\\\\s+ailment\\\\s+accuracy\\\\s+\\\\(up\\\\s+to\\\\s+(\\d+)%\\\\)\\\\.\\\\s*Inflict\\\\s+(\\d+)\\\\s+<link\\=\"s\\\\|(\\d+)\"><u>Sparks</u></link>\\\\s+stack\\\\s+for\\\\s+each\\\\s+time\\\\s+skill\\\\s+damage\\\\s+is\\\\s+dealt\\\\s+to\\\\s+a\\\\s+foe\\\\.\\\\s*Sparks\\\\s+from\\\\s+this\\\\s+effect\\\\s+can\\\\s+stack\\\\s+up\\\\s+to\\\\s+(\\d+)\\\\s+times\\\\.\\\\n<b><size\\=28><color\\=#850101>Gentle\\\\s+care\\\\s+and\\\\s+consideration\\\\s+ensures\\\\s+a\\\\s+fun-filled\\\\s+summer,\\\\s+healing\\\\s+all\\\\s+allies\\\\.</color></size></b>$\"": "",
  "r:\"^Deal\\\\s+Psy\\\\s+damage\\\\s+to\\\\s+all\\\\s+foes\\\\s+equal\\\\s+to\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+of\\\\s+Attack\\\\.\\\\s*For\\\\s+(\\d+)\\\\s+turns,\\\\s+increase\\\\s+foes'\\\\s+damage\\\\s+taken\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+and\\\\s+inflict\\\\s+(\\d+)\\\\s+<link\\=\"s\\\\|(\\d+)\"><u>Sparks</u></link>\\\\s+stack\\\\s+when\\\\s+foes\\\\s+take\\\\s+skill\\\\s+damage\\\\.\\\\s*At\\\\s+the\\\\s+start\\\\s+of\\\\s+Seaside\\\\s+Tomoko's\\\\s+turn,\\\\s+decrease\\\\s+this\\\\s+effect's\\\\s+duration\\\\s+by\\\\s+(\\d+)\\\\.\\\\s*Sparks\\\\s+stacks\\\\s+up\\\\s+to\\\\s+(\\d+)\\\\s+times\\\\s+and\\\\s+isn't\\\\s+inflicted\\\\s+by\\\\s+damage\\\\s+from\\\\s+this\\\\s+skill\\\\.\\\\n<b><size\\=28><color\\=#850101>Dazzling\\\\s+fireworks\\\\s+sear\\\\s+the\\\\s+mind's\\\\s+eye,\\\\s+dealing\\\\s+Psychokinesis\\\\s+damage\\\\s+to\\\\s+all\\\\s+foes\\\\.</color></size></b>$\"": "",
  "r:\"^Highlight：Deal\\\\s+Psy\\\\s+damage\\\\s+to\\\\s+random\\\\s+foes\\\\s+equal\\\\s+to\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+of\\\\s+Attack\\\\s+\\\\((\\d+)\\\\s+hits\\\\)\\\\.\\\\s*Prioritize\\\\s+attacking\\\\s+foes\\\\s+that\\\\s+have\\\\s+not\\\\s+been\\\\s+hit\\\\s+by\\\\s+this\\\\s+skill\\\\s+and\\\\s+inflict\\\\s+(\\d+)\\\\s+<link\\=\"s\\\\|(\\d+)\"><u>Sparks</u></link>\\\\s+stack\\\\s+per\\\\s+damage\\\\s+dealt\\\\.\\\\s*Repeated\\\\s+hits\\\\s+on\\\\s+the\\\\s+same\\\\s+target\\\\s+deal\\\\s+(\\d+)%\\\\s+damage\\\\.\\\\s*1\\\\s+MORE：Deal\\\\s+Psychokinesis\\\\s+damage\\\\s+to\\\\s+(\\d+)\\\\s+foe\\\\.\\\\s*Melee\\\\s+Attack：Deal\\\\s+Physical\\\\s+damage\\\\s+to\\\\s+(\\d+)\\\\s+foe\\\\.\\\\s*Ranged\\\\s+Attack：Deal\\\\s+Gun\\\\s+damage\\\\s+to\\\\s+(\\d+)\\\\s+foe\\\\.\\\\s*Can\\\\s+fire\\\\s+until\\\\s+out\\\\s+of\\\\s+ammo\\\\.$\"": "",
  "r:\"^When\\\\s+activating\\\\s+Hale\\\\s+Summer\\\\s+Days,\\\\s+increase\\\\s+the\\\\s+main\\\\s+target's\\\\s+max\\\\s+HP\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+)</color>\\\\s+for\\\\s+(\\d+)\\\\s+turns\\\\.\\\\s*Restore\\\\s+HP\\\\s+of\\\\s+the\\\\s+ally\\\\s+with\\\\s+the\\\\s+lowest\\\\s+HP,\\\\s+equal\\\\s+to\\\\s+<color\\=#FFFC40>(\\d+)%</color>\\\\s+of\\\\s+skill\\\\s+healing\\\\.$\"": "",
  "r:\"^During\\\\s+battle,\\\\s+increase\\\\s+Seaside\\\\s+Tomoko's\\\\s+damage\\\\s+and\\\\s+max\\\\s+HP\\\\s+based\\\\s+on\\\\s+her\\\\s+HP\\\\s+recovery\\\\.\\\\s*When\\\\s+HP\\\\s+recovery\\\\s+is\\\\s+at\\\\s+up\\\\s+to\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>,\\\\s+increase\\\\s+Psy\\\\s+damage\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+\\.?\\d*)%</color>\\\\s+and\\\\s+max\\\\s+HP\\\\s+by\\\\s+<color\\=#FFFC40>(\\d+)</color>\\\\.$\"": "",
